# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado para qualificação de leads
ANTHROPIC_MODEL=claude-sonnet-4-6

# URL do CRM (usada em src/crm_client.py quando você integrar de verdade)
CRM_WEBHOOK_URL=https://seu-crm.example.com/api/leads/route

# Token/segredo para validar a assinatura do webhook recebido (opcional, recomendado)
WEBHOOK_SECRET=troque-por-um-segredo-forte
